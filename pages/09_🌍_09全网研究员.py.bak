# pages/09_🌍_全网深度研究员.py
import streamlit as st
import requests
import re
from duckduckgo_search import DDGS
from core.settings import settings
from core.token_tracker import log_usage
from langchain_openai import ChatOpenAI

st.set_page_config(page_title="全网深度研究员", page_icon="🌍", layout="wide")

st.title("🌍 全网深度研究员 (时效资讯强化版)")
st.markdown("不仅能自动使用搜索引擎，还能深入阅读网页。本版本**已大幅强化最新资讯检索能力**")

# ==========================================
# 1. 打造 AI 的“手”和“眼” (纯函数工具)
# ==========================================
def search_web(query: str) -> str:
    """使用原生的 DDGS 库，提供远比 LangChain 自带包装器更丰富的内容"""
    try:
        # 默认使用 text 搜索，获取前 6 个最相关的结果
        results = DDGS().text(query, max_results=6)
        if not results:
            return "未找到相关结果，请尝试更换更大众的搜索关键词。"
            
        res_str = ""
        for i, r in enumerate(results):
            res_str += f"[{i+1}] 标题: {r.get('title', '')}\n链接: {r.get('href', '')}\n摘要: {r.get('body', '')}\n\n"
        return res_str
    except Exception as e:
        return f"搜索失败: {e}"

def read_webpage(url: str) -> str:
    """Jina Reader 穿透读取"""
    try:
        headers = {"Accept": "text/event-stream", "X-Retain-Images": "none"}
        response = requests.get(f"https://r.jina.ai/{url}", headers=headers, timeout=20)
        if response.status_code == 200:
            return f"【网页内容】\n{response.text[:15000]}"
        return f"读取失败，状态码: {response.status_code}"
    except Exception as e:
        return f"读取报错: {str(e)}"

# ==========================================
# 2. 页面与侧边栏配置
# ==========================================
with st.sidebar:
    st.header("⚙️ 研究员配置")
    agent_model = st.text_input("驱动引擎", value=settings.MODEL_TEXT or "deepseek-v3-0324")
    
    if st.button("🧹 清空研究记忆", use_container_width=True):
        st.session_state.research_chat_history = []
        st.rerun()

# 初始化 Session State
if "research_chat_history" not in st.session_state:
    st.session_state.research_chat_history = []

# ==========================================
# 3. 聊天与执行交互区
# ==========================================
# 渲染历史对话
for msg in st.session_state.research_chat_history:
    st.chat_message(msg["role"]).write(msg["content"])

if user_input := st.chat_input("向研究员发布任务：例如 '深度调研今日头条最新的 AI 动态'"):
    
    st.session_state.research_chat_history.append({"role": "user", "content": user_input})
    st.chat_message("user").write(user_input)

    with st.chat_message("assistant"):
        status_placeholder = st.empty()
        content_placeholder = st.empty()

        system_prompt = """你是一个世界顶尖的深度调查记者和网络研究员。
你可以使用的工具只有以下两个：
1. search_web: 用于全网搜索信息。参数必须是精准的搜索关键词（建议包含年份或"最新"等词汇以保证时效性）。
2. read_webpage: 用于深度读取网页全文。参数必须是完整的 URL。

你必须且只能严格遵守以下思考和行动格式（绝不允许输出其他格式或 JSON）：

Thought: 思考你需要做什么
Action: 决定使用的工具（必须且只能是 search_web 或 read_webpage 之一）
Action Input: 传给工具的参数（仅填关键词或网址，绝对不要加引号！）

等待系统返回 Observation（观察结果）后，你再继续下一步。
当你收集到足够信息，可以回答用户时，必须输出：

Thought: 我已经得出结论
Final Answer: [你的最终详细回答，必须包含参考的URL链接]"""

        # 拼接历史记录
        history_text = ""
        for msg in st.session_state.research_chat_history[:-1]:
            prefix = "User" if msg["role"] == "user" else "Assistant"
            history_text += f"{prefix}: {msg['content']}\n"

        current_prompt = f"{system_prompt}\n\n【历史对话】\n{history_text}\n\nUser: {user_input}\n"

        llm = ChatOpenAI(model=agent_model, api_key=settings.API_KEY, base_url=settings.API_BASE, temperature=0.1)

        step_count = 0
        max_steps = 6
        
        # 🌟 核心修复：在这里建立一个变量，用来精准累加每一次思考消耗的 Token
        total_session_tokens = 0 

        try:
            while step_count < max_steps:
                step_count += 1
                status_placeholder.info(f"🕵️‍♂️ 研究员正在思考和自主冲浪 (进行中: 步骤 {step_count}/{max_steps})...")

                # 调用大模型
                response = llm.invoke(current_prompt, stop=["Observation:", "Observation", "观察结果:"])
                reply = response.content.strip()
                
                # 🌟 核心修复：精准抓取原生 Token 消耗
                step_tokens = 0
                if hasattr(response, 'usage_metadata') and response.usage_metadata:
                    step_tokens = response.usage_metadata.get('total_tokens', 0)
                elif hasattr(response, 'response_metadata'):
                    step_tokens = response.response_metadata.get('token_usage', {}).get('total_tokens', 0)
                    
                # 如果内网网关吞了 Token，执行兜底计算
                if step_tokens == 0:
                    step_tokens = int((len(current_prompt) + len(reply)) * 1.2)
                    
                total_session_tokens += step_tokens # 累加到总计
                # ---------------------------------------------

                current_prompt += reply + "\n"

                # 1. 检查是否得出了最终结论
                if "Final Answer:" in reply:
                    final_answer = reply.split("Final Answer:")[-1].strip()
                    status_placeholder.empty()
                    content_placeholder.markdown(final_answer)
                    st.session_state.research_chat_history.append({"role": "assistant", "content": final_answer})
                    break

                # 2. 检查大模型是否下达了工具调用指令
                action_match = re.search(r"Action:\s*(.*?)(?:\n|$)", reply, re.IGNORECASE)
                input_match = re.search(r"Action Input:\s*(.*?)(?:\n|$)", reply, re.IGNORECASE)

                if action_match and input_match:
                    action = action_match.group(1).strip()
                    action_input = input_match.group(1).strip()

                    with st.expander(f"🛠️ 正在执行工具: `{action}`", expanded=False):
                        st.write(f"**提取参数**: {action_input}")
                        
                        if "search_web" in action:
                            obs = search_web(action_input)
                        elif "read_webpage" in action:
                            obs = read_webpage(action_input)
                        else:
                            obs = "无效的工具名称，请检查你的 Action。"
                            
                        st.write(f"**获得线索**: {str(obs)[:300]}...")

                    current_prompt += f"Observation: {obs}\n"
                else:
                    # 防呆兜底
                    status_placeholder.empty()
                    content_placeholder.markdown(reply)
                    st.session_state.research_chat_history.append({"role": "assistant", "content": reply})
                    break

            if step_count >= max_steps:
                status_placeholder.warning("⚠️ 已达到最大调查深度，系统强制终止了思考。")

            # 🌟 核心修复：循环结束后，统一入账并通知用户
            log_usage("全网深度研究员", agent_model, total_session_tokens)
            st.toast(f"💰 本次调研共消耗约 {total_session_tokens} Tokens，已计入总账单。", icon="📊")
            
        except Exception as e:
            st.error(f"🚨 研究引擎严重故障: {e}")